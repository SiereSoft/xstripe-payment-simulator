{
  "info": {
    "_postman_id": "f4ke57ri-pe00-4c01-9a11-fakestr1pe001",
    "name": "fake-stripe (local simulator)",
    "description": "Postman collection for the fake-stripe simulator (Ktor, http://localhost:12111).\n\nRequests are `application/x-www-form-urlencoded` with Stripe bracket notation (`metadata[k]=v`, `card[number]=…`, `expand[]=customer`) and JSON responses in Stripe's object shapes.\n\n## How to use\n1. Start the server: `./gradlew run` or `docker compose up --build`.\n2. Import this file into Postman.\n3. Run the whole collection with the **Collection Runner** (top-to-bottom) — requests chain IDs through collection variables (`customerId`, `pmId`, `paymentIntentId`, `chargeId`, …), so a full customer → payment-method → payment-intent → charge lifecycle runs in order.\n\nAuth: the simulator ignores the API key, but a Bearer token (`{{apiKey}}`) is sent on every request to mirror real Stripe.\n\nVariables live at the collection level (see the **Variables** tab) and are overwritten by test scripts as objects are created.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiKey}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:12111" },
    { "key": "controlUrl", "value": "http://localhost:12112" },
    { "key": "controlToken", "value": "gym_control_local" },
    { "key": "apiKey", "value": "sk_test_fake_stripe_123" },
    { "key": "customerId", "value": "" },
    { "key": "pmId", "value": "" },
    { "key": "paymentIntentId", "value": "" },
    { "key": "chargeId", "value": "" },
    { "key": "piNoCardId", "value": "" },
    { "key": "piUnconfirmedId", "value": "" },
    { "key": "manualPiId", "value": "" },
    { "key": "cancelPiId", "value": "" }
  ],
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Liveness (GET /healthz)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/healthz", "host": ["{{baseUrl}}"], "path": ["healthz"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ] } }
          ]
        },
        {
          "name": "Service info (GET /)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('is fake-stripe', () => pm.expect(pm.response.json().service).to.eql('fake-stripe'));"
            ] } }
          ]
        },
        {
          "name": "World health (GET /v1/admin/health)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Siere-Control-Token", "value": "{{controlToken}}" }],
            "url": { "raw": "{{controlUrl}}/v1/admin/health", "host": ["{{controlUrl}}"], "path": ["v1", "admin", "health"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('reports counts', () => { pm.expect(j).to.have.property('customers'); pm.expect(j).to.have.property('charges'); });"
            ] } }
          ]
        },
        {
          "name": "Reset world (POST /v1/admin/reset?seed=42)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Siere-Control-Token", "value": "{{controlToken}}" }],
            "body": { "mode": "urlencoded", "urlencoded": [] },
            "url": {
              "raw": "{{controlUrl}}/v1/admin/reset?seed=42",
              "host": ["{{controlUrl}}"],
              "path": ["v1", "admin", "reset"],
              "query": [{ "key": "seed", "value": "42" }]
            },
            "description": "Wipes and re-seeds the world deterministically. Same seed => identical objects, down to their IDs."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('reset echoed', () => { pm.expect(j.object).to.eql('admin.reset'); pm.expect(j.seed).to.eql(42); });"
            ] } }
          ]
        }
      ]
    },
