            "description": "A declined card returns HTTP 402 with a card_error whose `payment_intent` is embedded — exactly like real Stripe. Try `pm_card_chargeDeclinedInsufficientFunds`, `...LostCard`, `...ExpiredCard`, `...IncorrectCvc` for other decline_codes."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('402 Payment Required', () => pm.response.to.have.status(402));",
              "const j = pm.response.json();",
              "pm.test('card_error', () => pm.expect(j.error.type).to.eql('card_error'));",
              "pm.test('embeds payment_intent', () => pm.expect(j.error.payment_intent).to.be.an('object'));"
            ] } }
          ]
        },
        {
          "name": "Create + confirm PI (3DS) -> requires_action",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "amount", "value": "2000", "type": "text" },
                { "key": "currency", "value": "usd", "type": "text" },
                { "key": "customer", "value": "{{customerId}}", "type": "text" },
                { "key": "payment_method", "value": "pm_card_authenticationRequired", "type": "text" },
                { "key": "confirm", "value": "true", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/v1/payment_intents", "host": ["{{baseUrl}}"], "path": ["v1", "payment_intents"] },
            "description": "3-D Secure card lands in requires_action. NOTE: this build has no completion endpoint to walk it to succeeded (see README limitations)."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('requires_action', () => pm.expect(pm.response.json().status).to.eql('requires_action'));"
            ] } }
          ]
        },
        {
          "name": "Create PI to cancel",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "amount", "value": "500", "type": "text" },
                { "key": "currency", "value": "usd", "type": "text" },
                { "key": "customer", "value": "{{customerId}}", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/v1/payment_intents", "host": ["{{baseUrl}}"], "path": ["v1", "payment_intents"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('cancelPiId', pm.response.json().id);"
            ] } }
          ]
        },
        {
          "name": "Cancel PI -> canceled",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "cancellation_reason", "value": "requested_by_customer", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/v1/payment_intents/{{cancelPiId}}/cancel", "host": ["{{baseUrl}}"], "path": ["v1", "payment_intents", "{{cancelPiId}}", "cancel"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('canceled', () => pm.expect(pm.response.json().status).to.eql('canceled'));"
            ] } }
          ]
        },
        {
          "name": "List payment intents (by customer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_intents?customer={{customerId}}&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payment_intents"],
              "query": [
                { "key": "customer", "value": "{{customerId}}" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('is a list', () => pm.expect(pm.response.json().object).to.eql('list'));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "Charges",
      "item": [
        {
          "name": "List charges (by customer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/charges?customer={{customerId}}&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "charges"],
              "query": [
                { "key": "customer", "value": "{{customerId}}" },
                { "key": "payment_intent", "value": "{{paymentIntentId}}", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('is a list', () => pm.expect(j.object).to.eql('list'));",
              "if (j.data && j.data.length && !pm.collectionVariables.get('chargeId')) { pm.collectionVariables.set('chargeId', j.data[0].id); }"
            ] } }
          ]
        },
        {
          "name": "Retrieve charge",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/charges/{{chargeId}}", "host": ["{{baseUrl}}"], "path": ["v1", "charges", "{{chargeId}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('is a charge', () => pm.expect(pm.response.json().object).to.eql('charge'));"
            ] } }
          ]
        },
        {
          "name": "Update charge (metadata)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "metadata[reviewed]", "value": "true", "type": "text" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/v1/charges/{{chargeId}}", "host": ["{{baseUrl}}"], "path": ["v1", "charges", "{{chargeId}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "Errors (Stripe-shaped)",
      "item": [
        {
          "name": "Retrieve missing customer -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/customers/cus_does_not_exist", "host": ["{{baseUrl}}"], "path": ["v1", "customers", "cus_does_not_exist"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('invalid_request_error', () => pm.expect(pm.response.json().error.type).to.eql('invalid_request_error'));"
            ] } }
          ]
        },
        {
          "name": "Create customer missing/unknown URL -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/nonsense", "host": ["{{baseUrl}}"], "path": ["v1", "nonsense"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('unrecognized URL', () => pm.expect(pm.response.json().error.message).to.include('Unrecognized request URL'));"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "Cleanup (optional)",
      "item": [
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["v1", "customers", "{{customerId}}"] },
            "description": "Soft-deletes the customer and detaches its payment methods. Runs last so it doesn't break the flow above."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('deleted', () => pm.expect(pm.response.json().deleted).to.eql(true));"
            ] } }
          ]
        }
      ]
    }
  ]
