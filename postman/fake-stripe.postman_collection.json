            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "type",
                  "value": "card"
                },
                {
                  "key": "card[number]",
                  "value": "4242424242424242"
                },
                {
                  "key": "card[exp_month]",
                  "value": "12"
                },
                {
                  "key": "card[exp_year]",
                  "value": "2034"
                },
                {
                  "key": "card[cvc]",
                  "value": "123"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.id) pm.collectionVariables.set('paymentMethodId', d.id);",
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve payment method",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_methods/{{paymentMethodId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_methods",
                "{{paymentMethodId}}"
              ]
            }
          }
        },
        {
          "name": "Update payment method",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_methods/{{paymentMethodId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_methods",
                "{{paymentMethodId}}"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "billing_details[name]",
                  "value": "Jane Doe"
                }
              ]
            }
          }
        },
        {
          "name": "Attach to customer",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_methods/{{paymentMethodId}}/attach",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_methods",
                "{{paymentMethodId}}",
                "attach"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "customer",
                  "value": "{{customerId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Detach from customer",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_methods/{{paymentMethodId}}/detach",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_methods",
                "{{paymentMethodId}}",
                "detach"
              ]
            }
          }
        },
        {
          "name": "List payment methods",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_methods?customer={{customerId}}&type=card",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_methods"
              ],
              "query": [
                {
                  "key": "customer",
                  "value": "{{customerId}}"
                },
                {
                  "key": "type",
                  "value": "card"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "PaymentIntents",
      "item": [
        {
          "name": "Create (unconfirmed)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_intents"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "amount",
                  "value": "2000"
                },
                {
                  "key": "currency",
                  "value": "usd"
                },
                {
                  "key": "customer",
                  "value": "{{customerId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.id) pm.collectionVariables.set('paymentIntentId', d.id);",
                  "pm.test('2xx', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create & confirm (succeeds)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_intents"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "amount",
                  "value": "2000"
                },
                {
                  "key": "currency",
                  "value": "usd"
                },
                {
                  "key": "payment_method",
                  "value": "pm_card_visa"
                },
                {
                  "key": "confirm",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.id) pm.collectionVariables.set('paymentIntentId', d.id);",
                  "if (d.latest_charge) pm.collectionVariables.set('chargeId', d.latest_charge);",
                  "pm.test('succeeded', () => pm.expect(d.status).to.eql('succeeded'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create & confirm (declined)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment_intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "payment_intents"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "amount",
                  "value": "500"
                },
                {
                  "key": "currency",
                  "value": "usd"
                },
                {
                  "key": "payment_method",
                  "value": "pm_card_chargeDeclined"
                },
                {
                  "key": "confirm",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('402 card_error', () => {",
                  "  pm.expect(pm.response.code).to.eql(402);",
                  "  pm.expect(pm.response.json().error.type).to.eql('card_error');",
                  "});"
                ]
              }
            }
          ]
        },
