  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:12111"
    },
    {
      "key": "apiKey",
      "value": "sk_test_123"
    },
    {
      "key": "controlToken",
      "value": "gym_control_local"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "paymentMethodId",
      "value": ""
    },
    {
      "key": "paymentIntentId",
      "value": ""
