# Copy to .env and adjust. Every value here is a safe local-only default.
# `.env` is gitignored; never commit real credentials to this repository.

# --- Provider (actor-facing) listener -------------------------------------
# The Stripe-compatible API. Accepts any test-mode key, so keep it on loopback
# unless you have a specific reason. Docker sets HOST=0.0.0.0 inside the
# container and publishes the port to the host instead.
HOST=127.0.0.1
PORT=12111

# --- Controller listener ---------------------------------------------------
# Gym lifecycle + verifier endpoints. Must never be reachable by the system
# under test. Disabled entirely unless FAKE_STRIPE_CONTROL_TOKEN is set.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=12112

# Generate a real one for anything beyond your own machine:
#   FAKE_STRIPE_CONTROL_TOKEN=$(openssl rand -hex 24)
FAKE_STRIPE_CONTROL_TOKEN=gym_control_local

# --- World -----------------------------------------------------------------
# Same seed => same world, down to object IDs.
FAKE_STRIPE_SEED=1

# Plaintext state snapshot. Treat as sensitive; delete when finished.
FAKE_STRIPE_DATA=data/state.json

# 'free' follows wall time; 'manual' starts at a deterministic seeded time.
FAKE_STRIPE_CLOCK_MODE=free

# --- Webhooks --------------------------------------------------------------
# If set, signed events are POSTed here. Also settable at runtime via
# POST /v1/admin/webhook on the controller listener.
# FAKE_STRIPE_WEBHOOK_URL=http://127.0.0.1:9000/hook
FAKE_STRIPE_WEBHOOK_SECRET=whsec_test

# --- Hosted pages ----------------------------------------------------------
# Base URL embedded in hosted checkout/portal links. Set this when a browser
# reaches the simulator at a different address than the API caller does.
# FAKE_STRIPE_PUBLIC_URL=http://localhost:12111
